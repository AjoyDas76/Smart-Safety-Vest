<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/rootContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Same premium background photo used on the Login screen -->
        <ImageView
            android:id="@+id/imgHomeBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_login_bg" />

        <!-- Same dark scrim as Login, so text/glass cards stay readable -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8A050B14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Persistent VEST COMMAND top bar -->
        <LinearLayout
            android:id="@+id/vestCommandBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/bg_glass_strong_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/txtVestCommandBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="@string/vest_command"
                android:textColor="@color/dark_text_main"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/accent_green"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/status_online"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        </LinearLayout>

    </FrameLayout>

    <!-- Glass navigation drawer -->
    <LinearLayout
        android:id="@+id/drawerContent"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_glass"
        android:orientation="vertical"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/img_logo"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/txtDrawerBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/vest_command"
                android:textColor="@color/dark_text_main"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:itemIconTint="@color/accent_cyan"
            app:itemTextColor="@color/dark_text_main"
            app:menu="@menu/drawer_menu" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
