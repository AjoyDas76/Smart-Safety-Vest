<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_alert_item_active"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgAlertIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_alert"
        app:tint="@color/accent_red"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.03"
            android:text="High Temperature"
            android:textColor="@color/accent_red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtAlertTime"
            style="@style/GlassCardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Reading is outside the safe range"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
