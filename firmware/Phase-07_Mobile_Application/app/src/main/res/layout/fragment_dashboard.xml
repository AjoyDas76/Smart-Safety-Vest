<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Worker status card -->
        <LinearLayout
            android:id="@+id/cardWorkerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:id="@+id/txtWorkerStatusHeading"
                android:text="@string/worker_status"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="3">

                <TextView android:id="@+id/lblId" style="@style/GlassCardTextMuted" android:layout_columnWeight="1" android:layout_width="0dp" android:text="@string/label_id" />
                <TextView android:id="@+id/txtWorkerId" style="@style/GlassCardText" android:layout_columnWeight="1" android:layout_width="0dp" android:text="VST-001" android:textSize="14sp" />

                <TextView android:id="@+id/lblName" style="@style/GlassCardTextMuted" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="@string/label_name" />
                <TextView android:id="@+id/txtWorkerName" style="@style/GlassCardText" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="Rahim Uddin" android:textSize="14sp" />

                <TextView android:id="@+id/lblVestId" style="@style/GlassCardTextMuted" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="@string/label_vest_id" />
                <TextView android:id="@+id/txtVestId" style="@style/GlassCardText" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="SV-2026-014" android:textSize="14sp" />

                <TextView android:id="@+id/lblStatus" style="@style/GlassCardTextMuted" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="@string/label_status" />
                <TextView android:id="@+id/txtWorkerStatusValue" style="@style/GlassCardText" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="Active" android:textColor="@color/accent_green" android:textSize="14sp" />

                <TextView android:id="@+id/lblShift" style="@style/GlassCardTextMuted" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="@string/label_shift" />
                <TextView android:id="@+id/txtShift" style="@style/GlassCardText" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_marginTop="10dp" android:text="Day (08:00 - 20:00)" android:textSize="14sp" />
            </GridLayout>
        </LinearLayout>

        <!-- Sensor grid: Temperature / Humidity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include layout="@layout/item_sensor_card" android:id="@+id/cardTemperature"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" />

            <include layout="@layout/item_sensor_card" android:id="@+id/cardHumidity"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Sensor grid: Pressure / Active Alerts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include layout="@layout/item_sensor_card" android:id="@+id/cardPressure"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" />

            <include layout="@layout/item_sensor_card" android:id="@+id/cardActiveAlerts"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Motion State (same card design as Temperature/Humidity/Pressure) -->
        <include layout="@layout/item_sensor_card" android:id="@+id/cardMotionState"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

        <!-- Active Alerts list (bottom-most block): shows every currently active hazard alert -->
        <LinearLayout
            android:id="@+id/cardDashboardAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:id="@+id/txtDashboardAlertsHeading"
                    android:text="@string/active_alerts"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtDashboardAlertCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_alert_count_badge"
                    android:minWidth="18dp"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDashboardAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/txtDashboardNoAlerts"
                style="@style/GlassCardTextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="No active hazardous alerts"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Event / Alert History table (very bottom of the dashboard) -->
        <LinearLayout
            android:id="@+id/cardEventHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/accent_cyan"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_history_title_badge"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:id="@+id/txtEventHistoryHeading"
                    android:text="@string/event_alert_history"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Column headers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/GlassCardTextMuted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:letterSpacing="0.06"
                    android:id="@+id/txtColTime"
                    android:text="@string/col_time"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp" />

                <TextView
                    style="@style/GlassCardTextMuted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:letterSpacing="0.06"
                    android:id="@+id/txtColEvent"
                    android:text="@string/col_event"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp" />

                <TextView
                    style="@style/GlassCardTextMuted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.06"
                    android:id="@+id/txtColStatus"
                    android:text="@string/col_status"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp" />

                <TextView
                    style="@style/GlassCardTextMuted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:letterSpacing="0.06"
                    android:id="@+id/txtColMotionTemp"
                    android:text="@string/col_motion_temp"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEventHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/txtNoHistory"
                style="@style/GlassCardTextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/history_no_data"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
