<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/cardTempChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:id="@+id/txtLiveTempChartHeading"
                android:text="@string/live_temp_chart"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartTemperature"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardHumidityChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:id="@+id/txtLiveHumidityChartHeading"
                android:text="@string/live_humidity_chart"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartHumidity"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPressureChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:id="@+id/txtLivePressureChartHeading"
                android:text="@string/live_pressure_chart"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartPressure"
                android:layout_width="match_parent"
                android:layout_height="180dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
