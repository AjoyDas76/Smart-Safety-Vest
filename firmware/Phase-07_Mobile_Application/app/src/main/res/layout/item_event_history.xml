<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_history_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/txtHistoryTime"
        style="@style/GlassCardText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:fontFamily="monospace"
        android:text="20:47:45"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtHistoryEvent"
        style="@style/GlassCardText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="Sync"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill_online"
            android:fontFamily="sans-serif-medium"
            android:text="✓ SAFE"
            android:textColor="@color/accent_green"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtHistoryMotionTemp"
        style="@style/GlassCardText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:text="STANDING | 30.9°C"
        android:textSize="12sp" />

</LinearLayout>
